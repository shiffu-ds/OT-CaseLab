# Copy to .env.production; keep it mode 600 and outside version control.
# Run python infra/generate_secrets.py .env.production to fill random service secrets.
# Supply a real DNS name and ensure HTTPS origin exactly matches the browser origin.
APP_DOMAIN=staging.example.invalid
APP_ORIGIN=https://staging.example.invalid
ENVIRONMENT=production
COOKIE_SECURE=true
ALLOW_DEMO=false
SESSION_HOURS=12
POSTGRES_PASSWORD=GENERATE_LOCALLY
APP_DB_PASSWORD=GENERATE_LOCALLY
MCP_SERVICE_SECRET=GENERATE_LOCALLY
MCP_HTTP_BEARER_TOKEN=GENERATE_LOCALLY
PROVIDER_MODE=scripted
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
NLP_MODE=baseline
CV_MODE=baseline
INSTALL_NEURAL=false
RELEASE_TAG=local
RESEARCH_EXPORTS_ENABLED=false
RESEARCH_EXPORT_SECRET=
REQUEST_LIMIT_BYTES=6291456
AGENT_MAX_CALLS=8
AGENT_DEADLINE_SECONDS=60
