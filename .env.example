# Local fictional demo; copy to .env. Real passwords/keys must never be committed.
DATABASE_URL=sqlite:///.runtime/otcaselab.db
APP_ORIGIN=http://localhost:3005
ENVIRONMENT=development
COOKIE_SECURE=false
ALLOW_DEMO=true
SESSION_HOURS=12

# Visible provider modes. Baselines need no cloud account or API key.
PROVIDER_MODE=scripted
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
NLP_MODE=baseline
CV_MODE=baseline
AGENT_PLANNER=rule
AGENT_DEADLINE_SECONDS=60
AGENT_MAX_CALLS=8
MODEL_CPU_THREADS=2
MODEL_CACHE_PATH=.runtime/models

# A private local secret is generated automatically when blank in development.
# Production requires explicit >=32 character random keys and HTTPS.
MCP_SERVICE_SECRET=
MCP_TRANSPORT=stdio
MCP_URL=http://mcp:9000/mcp
MCP_HTTP_BEARER_TOKEN=
JOB_MODE=local
REDIS_URL=redis://localhost:6379/0
PRIVATE_ASSET_PATH=.runtime/uploads
REQUEST_LIMIT_BYTES=6291456

# Enable only after an authorized research process. Separate export key required.
RESEARCH_EXPORTS_ENABLED=false
RESEARCH_EXPORT_SECRET=

# Frontend process reads these directly; PORT overrides local dev port.
API_INTERNAL_URL=http://127.0.0.1:8000
PORT=3005
